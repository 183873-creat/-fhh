rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'rafikamessoubeur10@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // المنتجات والإعدادات: القراءة للجميع، الكتابة لك فقط
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }

    // الطلبات: أي زبون يستطيع إنشاء طلب، لكن القراءة والتعديل والحذف لك فقط
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasAll(['name','phone','wilaya','address','items','total'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() < 100
                    && request.resource.data.items.size() < 50;
      allow read, update, delete: if isAdmin();
    }
  }
}
